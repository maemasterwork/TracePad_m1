# Copy to apps/web/.env.local for local development. All values are public (they ship in the browser bundle).
# Never put a service_role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Comma-separated list of sign-in providers to show, configured in Supabase: google, azure. Empty hides the buttons.
VITE_OAUTH_PROVIDERS=
# Learners without an email sign in with a username stored as <username>@<this domain>. Must not receive mail.
VITE_USERNAME_DOMAIN=students.tracepad.app
